{
  "name": "Calendar List Helper (agent tool)",
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/New_York"
  },
  "nodes": [
    {
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "name": "List Events (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "timeMin",
              "value": "={{ $now.minus({ days: 30 }).toISO() }}"
            },
            {
              "name": "timeMax",
              "value": "={{ $now.plus({ days: 180 }).toISO() }}"
            },
            {
              "name": "singleEvents",
              "value": "true"
            },
            {
              "name": "orderBy",
              "value": "startTime"
            },
            {
              "name": "maxResults",
              "value": "100"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Compact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json || {};\nconst items = Array.isArray(resp.items) ? resp.items : [];\nreturn items.map((e) => ({\n  json: {\n    id: e.id,\n    recurringEventId: e.recurringEventId || null, // master series id (recurring only); target this once for whole-series delete/edit\n    summary: e.summary || '(no title)',\n    start: (e.start && (e.start.dateTime || e.start.date)) || null,\n    end: (e.end && (e.end.dateTime || e.end.date)) || null,\n    status: e.status\n  }\n}));"
      }
    }
  ],
  "connections": {
    "When Called": {
      "main": [
        [
          {
            "node": "List Events (HTTP)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Events (HTTP)": {
      "main": [
        [
          {
            "node": "Compact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}